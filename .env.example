# Copie a .env y cambie TODOS los valores antes de producción
DB_PASSWORD=cambiar-clave-bd
DB_ROOT_PASSWORD=cambiar-clave-root
JWT_SECRET=cambiar-por-una-cadena-aleatoria-de-64-caracteres
# Manager: administra los centros de formación y sus administradores
MANAGER_EMAIL=manager@sena.edu.co
MANAGER_PASSWORD=Cambiar123!
# Centro por defecto: recibe al administrador inicial, el listado maestro de SEED_EXCEL y,
# al actualizar una base anterior a los centros, todos los datos existentes
CENTRO_CODIGO=CASA
CENTRO_NOMBRE=Centro de Atención al Sector Agropecuario
CENTRO_REGIONAL=Santander
# Datos del formato GIL-F-014 del centro por defecto y sus coordinaciones iniciales (separadas por |)
CENTRO_COD_REGIONAL=68
CENTRO_COSTO=912238
COORDINACIONES=Coordinación Académica|Coordinación de Programas Especiales|Coordinación del Centro de Convivencia (Playón)
# Entrega de materiales: dominios de correo permitidos para el autorregistro de instructores (vacío = cualquiera)
REGISTRO_DOMINIOS=sena.edu.co
# Plazo de legalización (días hábiles, sin festivos) y frecuencia de los recordatorios de extemporaneidad (días)
DIAS_HABILES_LEGALIZACION=15
DIAS_RECORDATORIO_EXTEMPORANEO=7
# Administrador inicial del centro por defecto
ADMIN_EMAIL=admin@sena.edu.co
ADMIN_PASSWORD=Cambiar123!
# Carga inicial del listado maestro (sólo si la BD está vacía). Ruta dentro del contenedor:
SEED_EXCEL=/seed/ESTUDIO DE MERCADOS_BCTUCU_CASA_2026 (1).xlsx
# 1 = crea vigencia 2027 abierta, un líder por lote (clave Lider123!) y proveedores de ejemplo
SEED_DEMO=0
PORT=8000

# --- Correo (notificaciones y credenciales). Vacío = sólo notificaciones en la aplicación ---
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=materiales.casa@sena.edu.co
SMTP_PASSWORD=cambiar
SMTP_FROM=materiales.casa@sena.edu.co
SMTP_STARTTLS=1
SMTP_SSL=0
# URL pública de la aplicación (se usa en los enlaces de los correos)
APP_URL=https://materiales.casa.sena.edu.co
